# Optional. Loaded automatically from .env. Without it, sample profiles still run.
# A working public-profile token already lives in PostlensUsers/.env.
X_BEARER_TOKEN=

# Optional. When set, Grok writes the @reply only.
# It cannot change the percentile, fandom, superpower, or alchemy.
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
